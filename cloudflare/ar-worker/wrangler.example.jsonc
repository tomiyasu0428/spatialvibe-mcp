// Copy to wrangler.jsonc (git-ignored) and replace the placeholders.
// Use a NEW private bucket only for this Worker; keep r2.dev and custom domains off.
// Set the upload credential with `wrangler secret put UPLOAD_TOKEN` (reads stdin; never a CLI argument).
{
  "name": "spatialvibe-ar",
  "account_id": "REPLACE-ACCOUNT-ID",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 100 },
  "vars": {
    "PUBLIC_ORIGIN": "https://spatialvibe-ar.REPLACE-SUBDOMAIN.workers.dev",
    "MAX_UPLOAD_BYTES": "8388608"
  },
  "r2_buckets": [{ "binding": "AR_BUCKET", "bucket_name": "REPLACE-NEW-PRIVATE-BUCKET" }]
}
