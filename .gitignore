# Python
.venv/
__pycache__/
*.pyc

# Project data (versions, STL/STEP/USDZ, previews) — local only
data/

# Reels: scenes.json is the source; html/mp4 are regenerated by reel/make_reel.py
reels/*/reel.html
reels/*/reel.mp4

# Claude Code local settings
.claude/settings.local.json

# OS / editor
.DS_Store
.idea/
.vscode/
reels/*/audio.wav
.wrangler/
.env*
.dev.vars*

# Local Cloudflare AR launch settings (0600, personal paths/origin)
.spatialvibe-ar.local.json
# Real deployment configs and local operator/diagnostic outputs never belong in git
wrangler.jsonc
wrangler.toml
*.prepared.jsonc
*-result.json
*-state.json
node_modules/

# demo clips: html is the source; mp4/png are regenerated by demo/*/render.py
demo/*/*.mp4
demo/*/*.png
# assembly reel: generated page/mp4/png (may embed photos) — never commit
demo/*/out/
